<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LidarrPluginCommonVersion>1.18.0</LidarrPluginCommonVersion>
    <LidarrPluginCommonTestKitVersion>1.1.8</LidarrPluginCommonTestKitVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Versions come from Directory.Packages.props (Central Package Management).
         xunit must match Lidarr.Plugin.Common.TestKit's xunit.extensibility.core pin (2.9.3)
         or NuGet reports NU1107. -->
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>
  <ItemGroup Condition="'$(LidarrPluginCommonRepoRoot)' != ''">
    <ProjectReference Include="$(LidarrPluginCommonRepoRoot)/testkit/Lidarr.Plugin.Common.TestKit.csproj" />
    <ProjectReference Include="../../src/MyPlugin/MyPlugin.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(LidarrPluginCommonRepoRoot)' == ''">
    <!-- VersionOverride: see the plugin csproj note - CPM forbids a plain Version attribute. -->
    <PackageReference Include="Lidarr.Plugin.Common.TestKit" VersionOverride="$(LidarrPluginCommonTestKitVersion)" />
    <ProjectReference Include="../../src/MyPlugin/MyPlugin.csproj" />
  </ItemGroup>
</Project>
